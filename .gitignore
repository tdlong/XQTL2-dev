slurm*

# large data/archives
*.tar
*.tar.gz
*.bam
*.bai
*.rds
*.RDS

# R workspace dumps
.RData
.Rhistory

# pipeline output / diagnostic reports
*.out
*_report.txt

# directories that are all output or data (never tracked)
data/
ref/
figures/
process/
# dated/alt output dirs, e.g. process.Dec6/
process.*/
output/
configs/

# stray figure images (figures live in figures/, never loose in git)
*.png
*.pdf
*.jpg
*.jpeg

# the pipeline symlink is machine-specific
pipeline

# macOS
.DS_Store

# Excel lock files
~$*

# cluster state output
check_cluster_state.out.txt

# logs/ is TRACKED (subdivided by project) so SLURM logs sync via git and Claude
# can pull + read them instead of the user pasting. This must override the
# slurm* and *.out patterns above for anything under logs/. Prune old logs freely.
!logs/
!logs/**

# ── universal (added by apply.sh) ──
._*
.Spotlight-V100
.Trashes
*.tmp
*.swp
.~lock*
__pycache__/
*.pyc
node_modules/
.quarto/

# ── from setup-review.md (added by apply.sh) ──
R.haps.chr2L.out.rds
repro_error.tar.gz
