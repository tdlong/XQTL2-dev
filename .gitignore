slurm*

# large data/archives
*.tar
*.tar.gz
*.bam
*.bai
*.rds
*.RDS

# R workspace dumps
.RData
.Rhistory

# pipeline output / diagnostic reports
*.out
*_report.txt

# directories that are all output or data (never tracked)
data/
ref/
figures/
process/
# dated/alt output dirs, e.g. process.Dec6/
process.*/
output/
logs/
configs/

# stray figure images (figures live in figures/, never loose in git)
*.png
*.pdf
*.jpg
*.jpeg

# the pipeline symlink is machine-specific
pipeline

# macOS
.DS_Store

# Excel lock files
~$*

# cluster state output
check_cluster_state.out.txt
